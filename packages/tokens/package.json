{
  "name": "@b4/tokens",
  "version": "0.0.1",
  "description": "B4 design tokens — Graphite and Porcelain themes, density/radius/accent/contrast/motion scales.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/b4-tokens.css",
    "./css/graphite": "./dist/theme-graphite.css",
    "./css/porcelain": "./dist/theme-porcelain.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node ../../scripts/copy-css.mjs tokens",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
