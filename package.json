{
  "name": "b4-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "B4 design system monorepo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/**\" run build",
    "dev:studio": "pnpm --filter @b4/studio dev",
    "storybook": "pnpm --filter @b4/studio storybook",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "test:watch": "pnpm --filter @b4/react run test -- --watch",
    "test:e2e": "playwright test",
    "consumer-smoke": "node scripts/consumer-smoke.mjs",
    "ssr-smoke": "node scripts/ssr-smoke.mjs",
    "treeshake-check": "node scripts/treeshake-check.mjs",
    "release:verify": "pnpm build && pnpm typecheck && pnpm --filter @b4/react run test && pnpm --filter @b4/motion run test && pnpm --filter @b4/studio run build && pnpm --filter @b4/studio run build-storybook && pnpm consumer-smoke && pnpm ssr-smoke && pnpm treeshake-check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
